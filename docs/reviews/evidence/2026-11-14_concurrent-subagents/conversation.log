   305	def project_catalog(roots):
   306	    """Small sidebar summaries; reads never update the activity timestamp."""
   307	    if not isinstance(roots,list) or len(roots)>500 or any(not isinstance(p,str) for p in roots):
   308	        raise ValueError('项目列表格式错误或超过500项')
   309	    projects=[]
   310	    for raw in roots:
   311	        entry={'root':raw,'name':Path(raw).name,'last_activity':0.0,'packages':[],'error':None}
   312	        try:
   313	            root=canonical(raw)
   314	            if inside(root,'.scs/state.sqlite3').is_file():
   315	                with database(root,timeout=0.15) as con:
   316	                    latest=con.execute('SELECT max(at) FROM events').fetchone()[0]
   317	                    entry['last_activity']=timestamp(latest)
   318	                    has_revisions=con.execute("SELECT 1 FROM sqlite_master WHERE name='work_package_revisions'").fetchone()
   319	                    if has_revisions:
   320	                        query='''SELECT p.id,p.state,p.data,p.created_at,coalesce((SELECT max(captured_at)
   321	                          FROM work_package_revisions r WHERE r.package_id=p.id),p.created_at) AS activity
   322	                          FROM work_packages p WHERE p.state NOT IN ('COMPLETED','ABANDONED')
   323	                          ORDER BY activity DESC,p.id LIMIT 8'''
   324	                    else:
   325	                        query='''SELECT id,state,data,created_at,created_at AS activity FROM work_packages
   326	                          WHERE state NOT IN ('COMPLETED','ABANDONED') ORDER BY created_at DESC,id LIMIT 8'''
   327	                    for row in con.execute(query):
   328	                        last=timestamp(row['activity'])
   329	                        entry['last_activity']=max(entry['last_activity'],last)
   330	                        goal=json.loads(row['data']).get('goal',row['id'])
   331	                        entry['packages'].append({'id':row['id'],'goal':str(goal)[:160],'state':row['state'],'last_activity':last})
   332	            else:
   333	                entry['last_activity']=root.stat().st_mtime
   334	        except (ValueError,OSError,sqlite3.Error,KeyError,TypeError):
   335	            entry['error']='项目暂不可读取'
   336	        projects.append(entry)
   337	    return projects
