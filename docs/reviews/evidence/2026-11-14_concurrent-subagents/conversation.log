    38	def package_state_label(package):
    39	    label = STATE_LABELS.get(package["state"], package["state"])
    40	    if package["state"] in CLOSED_STATES:
    41	        return label
    42	    days = age_days(package.get("updated_at") or package.get("created_at"))
    43	    return label + (f" · 滞留 {days} 天" if days is not None and days >= 7 else "")
