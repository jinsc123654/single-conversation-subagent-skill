   297	def registered_projects():
   298	    source = Path(__file__).resolve().parents[3] / "mcp_server/src"
   299	    if source.is_dir() and str(source) not in sys.path:
   300	        sys.path.insert(0, str(source))
   301	    from scs_mcp.project_index import registered_projects as read_index
