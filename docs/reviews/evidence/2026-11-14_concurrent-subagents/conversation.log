   224	def obsidian_target(root, selection=None):
   225	    root = canonical(root)
   226	    selected = inside(root, selection or root)
   227	    if not selected.exists():
   228	        raise ValueError("选中的路径不存在")
   229	    base = selected if selected.is_dir() else selected.parent
   230	    # Prefer the nearest real vault, including nested projects' docs folders.
   231	    vault = None
   232	    if selected == root:
   233	        vault = registered_docs_root(root)
   234	    for parent in (base, *base.parents):
   235	        if vault or not parent.is_relative_to(root):
   236	            break
   237	        if inside(root, parent / ".obsidian").is_dir():
   238	            vault = parent
   239	            break
   240	        for name in DOCS:
   241	            candidate = inside(root, parent / name)
   242	            if candidate.is_dir() and inside(root, candidate / ".obsidian").is_dir():
   243	                vault = candidate
   244	                break
   245	        if vault:
   246	            break
   247	    vault = vault or docs_root(root)
   248	    overview = vault / "agent/acceptance/00_项目总览.md"
   249	    if selected.suffix.lower() == ".md" and selected.is_file() and selected.is_relative_to(vault):
   250	        target = selected
   251	    elif inside(root, overview).is_file():
   252	        target = overview
   253	    else:
   254	        # A folder is not a note: use the absolute vault path parameter.
   255	        return {"vault_root": str(vault), "uri": "obsidian://open?" + urlencode({"vault": str(vault)}, quote_via=quote)}
   256	    return {"vault_root": str(vault), "note_path": str(target), "uri": "obsidian://open?" + urlencode({"path": str(target)}, quote_via=quote)}
