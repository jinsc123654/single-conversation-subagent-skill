   196	    def claim(self, session_id: str, question_id: str) -> tuple[bool, dict]:
   197	        """Atomically reserve the single UI request across concurrent MCP processes."""
   198	        with self.store.transaction(True) as con:
   199	            q = con.execute("SELECT * FROM questions WHERE id=? AND session_id=?", (question_id, session_id)).fetchone()
   200	            if not q or not q["current"]:
   201	                raise ScsError("LATE_REPLY", "This question was replaced.")
   202	            if q["state"] != "REQUESTED":
   203	                return False, dict(q)
   204	            con.execute("UPDATE questions SET state='WAITING_USER',updated_at=? WHERE id=?", (now(), question_id))
   205	            self.store.event(con, session_id, question_id, "interaction_request", "WAITING_USER")
