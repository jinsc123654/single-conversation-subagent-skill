   232	                 "timeout": "HOST_OBSERVED_TIMEOUT", "unsupported": "ELICITATION_UNSUPPORTED", "error": "RPC_ERROR"}
   233	        with self.store.transaction(True) as con:
   234	            self._session(con, session_id)
   235	            q = con.execute("SELECT * FROM questions WHERE id=? AND session_id=?", (question_id, session_id)).fetchone()
   236	            if q is None:
   237	                raise ScsError("QUESTION_NOT_FOUND", "Question is not part of this conversation.")
   238	            if not q["current"]:
   239	                raise ScsError("LATE_REPLY", "A reply for a replaced question is isolated.")
   240	            answer = encode(check_selection(q["kind"], choices or [])) if action == "accept" else None
   241	            if q["state"] in TERMINAL:
   242	                if q["state"] == target and q["answer"] == answer:
   243	                    return {"status": target, "question_id": question_id, "idempotent": True}
   244	                raise ScsError("REPLY_CONFLICT", "This question has already ended. Explicitly reopen to change it.")
   245	            con.execute("UPDATE questions SET state=?,answer=?,updated_at=? WHERE id=?", (target, answer, now(), question_id))
   246	            if action == "accept":
   247	                selected = json.loads(answer)
   248	                column = {"mode": "mode", "verification": "verification", "codex_review": "codex_review"}[q["kind"]]
   249	                value = answer if q["kind"] == "verification" else (int(selected[0] == "yes") if q["kind"] == "codex_review" else selected[0])
   250	                con.execute(f"UPDATE sessions SET {column}=? WHERE id=?", (value, session_id))
   251	            self.store.event(con, session_id, question_id, "interaction_submit", codes[action],
   252	                             codes[action] if action in {"error", "unsupported", "timeout"} else None)
   253	        return {"status": target, "question_id": question_id, "choices": choices if action == "accept" else None,
   254	                "error_code": codes[action], "source": source, "destructive_operations_authorized": False}
   255	
   256	    def reopen(self, session_id: str, kind: str, explicit_user_change: bool = False) -> dict:
   257	        if kind not in KINDS:
   258	            raise ScsError("INPUT_INVALID", "Unknown question kind.")
   259	        with self.store.transaction(True) as con:
   260	            session = self._session(con, session_id)
   261	            q = con.execute("SELECT * FROM questions WHERE session_id=? AND kind=? AND current=1", (session_id, kind)).fetchone()
   262	            if not q:
   263	                # The explicit skip path confirms quick without creating a question.
   264	                # A later explicit mode change must still be representable in this chat.
   265	                if kind == "mode" and session["mode"] and explicit_user_change:
   266	                    con.execute("UPDATE sessions SET mode=NULL WHERE id=?", (session_id,))
   267	                    self.store.event(con, session_id, None, "interaction_reopen", "EXPLICIT_MODE_CHANGE")
   268	                    return {"status": "REOPENED", "previous_question_id": None, "next": "interaction_request"}
   269	                raise ScsError("QUESTION_NOT_FOUND", "There is no current question to reopen.")
   270	            if q["state"] in {"REQUESTED", "WAITING_USER", "CONFIRMED"} and not explicit_user_change:
   271	                raise ScsError("EXPLICIT_CHANGE_REQUIRED", "Reopening an active or confirmed question requires an explicit user change.")
