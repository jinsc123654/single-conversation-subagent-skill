   162	def discover(root, depth=2, maximum=2000):
   163	    """Only scan the chosen directory and at most two descendant levels."""
   164	    root = canonical(root)
   165	    found, queue, visited, truncated = [], [(root, 0)], 0, False
   166	    while queue and visited < maximum:
   167	        current, level = queue.pop(0)
   168	        visited += 1
   169	        if not (current / ".scs").is_symlink() and (current / ".scs/state.sqlite3").is_file():
   170	            found.append(str(current))
   171	        if level < depth:
   172	            with os.scandir(current) as entries:
   173	                # Bound broad directories too, rather than materializing all children.
   174	                for entry in entries:
   175	                    if len(queue) + visited >= maximum:
   176	                        truncated = True
   177	                        break
   178	                    if entry.name not in EXCLUDED and not entry.name.startswith(".") and entry.is_dir(follow_symlinks=False):
   179	                        queue.append((Path(entry.path), level + 1))
   180	    return {"projects": sorted(found), "visited": visited, "truncated": truncated or bool(queue), "depth": depth}
