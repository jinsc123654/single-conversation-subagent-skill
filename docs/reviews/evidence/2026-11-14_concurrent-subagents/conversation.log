   273	            # changes. Already confirmed scopes remain this conversation's choices.
   274	            dependent = {"mode": ("verification", "codex_review"), "verification": ("codex_review",), "codex_review": ()}[kind]
   275	            for child_kind in dependent:
   276	                child = con.execute("SELECT * FROM questions WHERE session_id=? AND kind=? AND current=1 AND state != 'CONFIRMED'",
   277	                                    (session_id, child_kind)).fetchone()
