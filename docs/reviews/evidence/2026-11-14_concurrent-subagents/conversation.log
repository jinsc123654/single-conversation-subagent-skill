   259	def archive_view(root):
   260	    """Move the whole owned view, preserving annotations/extras; serialize with MCP writers.
   261	
   262	    No state/evidence/vault configuration deletion. Explicit GUI confirmation precedes
   263	    this command. External editor writes are outside SQLite's coordination boundary.
   264	    """
   265	    root = canonical(root)
   266	    with database(root, write=True):
   267	        m = manifest(root)
   268	        if m is None:
   269	            raise ValueError("没有可归档的受管视图")
   270	        source = inside(root, docs_root(root) / "agent/acceptance")
   271	        # Preserve everything, refuse symlinks/special files and bound traversal.
   272	        count = 0
   273	        for base, dirs, files in os.walk(source, followlinks=False):
   274	            for name in dirs + files:
   275	                p = inside(root, Path(base) / name)
   276	                if not (p.is_file() or p.is_dir()):
   277	                    raise ValueError("视图含特殊文件，停止归档")
   278	                count += 1
   279	                if count > 12000:
   280	                    raise ValueError("视图太大，请人工管理")
   281	        destination = inside(root, source.parent / "view-archives")
   282	        destination.mkdir(exist_ok=True)
   283	        tag = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ") + "-" + uuid.uuid4().hex[:8]
   284	        destination = destination / tag
   285	        source.rename(destination)
   286	    return {"archive": str(destination), "files_and_folders": count,
   287	            "message": "已归档整个视图（含批注及额外笔记）；自动刷新暂停。下次刷新会重新生成。"}
