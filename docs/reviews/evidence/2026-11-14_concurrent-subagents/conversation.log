    26	def age_days(stamp):
    27	    if not stamp:
    28	        return None
    29	    try:
    30	        value = datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
    31	    except ValueError:
    32	        return None
    33	    if value.tzinfo is None:
    34	        value = value.replace(tzinfo=timezone.utc)
    35	    return max(0, (datetime.now(timezone.utc) - value).days)
