   279	                    con.execute("UPDATE questions SET current=0,updated_at=? WHERE id=?", (now(), child["id"]))
   280	                    self.store.event(con, session_id, child["id"], "interaction_reopen", "SUPERSEDED")
   281	            con.execute("UPDATE questions SET current=0,updated_at=? WHERE id=?", (now(), q["id"]))
   282	            column = {"mode": "mode", "verification": "verification", "codex_review": "codex_review"}[kind]
   283	            con.execute(f"UPDATE sessions SET {column}=NULL WHERE id=?", (session_id,))
   284	            self.store.event(con, session_id, q["id"], "interaction_reopen", "SUPERSEDED")
   285	        return {"status": "REOPENED", "previous_question_id": q["id"], "next": "interaction_request"}

