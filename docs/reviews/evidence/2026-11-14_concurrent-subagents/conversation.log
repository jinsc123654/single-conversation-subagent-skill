   309	    def render_packages(self):
   310	        packages = (self.current_snapshot or {}).get("packages", [])
   311	        show_closed = self.show_closed.isChecked()
   312	        self.visible_packages = [p for p in packages if show_closed or p["state"] not in CLOSED_STATES]
   313	        self.packages.setRowCount(len(self.visible_packages))
   314	        for row, package in enumerate(self.visible_packages):
   315	            values = (package["id"] + "\n" + package["goal"], package["revision"],
   316	                      package_state_label(package), package["tasks"])
   317	            for column, value in enumerate(values):
   318	                item = QTableWidgetItem(str(value))
   319	                item.setToolTip(package.get("close_reason") or str(value))
   320	                self.packages.setItem(row, column, item)
   321	        self.packages.resizeRowsToContents()
   322	        self.update_close_button()
