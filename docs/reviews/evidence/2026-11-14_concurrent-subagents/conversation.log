   244	    def resume(self, session_id: str, handoff_id: str, digest: str) -> dict:
   245	        with self.store.transaction(True) as con:
   246	            self.state._session(con, session_id)
   247	            handoff = con.execute("SELECT * FROM handoffs WHERE id=?", (handoff_id,)).fetchone()
