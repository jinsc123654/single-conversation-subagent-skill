   145	                    "version": row["version"], "state": row["state"], "tasks": len(data["subtasks"]),
   146	                    "docs_root": row["docs_root"], "session_id": row["session_id"], "created_at": row["created_at"],
   147	                    "updated_at": data.get("updated_at"), "closed_at": data.get("closed_at"),
   148	                    "close_reason": data.get("close_reason")})
   149	            result["events"] = [dict(r) for r in con.execute(
   150	                "SELECT at,tool,event,error_code FROM events ORDER BY seq DESC LIMIT 40")]
   151	            result["counts"] = {table: con.execute("SELECT count(*) FROM " + table).fetchone()[0]
   152	                                for table in ("sessions", "work_packages", "events")}
   153	        m = manifest(root)
