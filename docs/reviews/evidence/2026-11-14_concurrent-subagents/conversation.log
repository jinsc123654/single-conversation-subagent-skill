   193	                if not task or result.get("status") not in RESULTS:
   194	                    raise ScsError("SUBTASK_INVALID", "Result must name a subtask and an allowed status.")
   195	                validation = json.loads(session["verification"]) if session["verification"] else []
   196	                if task["kind"] == "test" and set(validation) & {"none", "method-only"} and result["status"] != "NOT_RUN":
   197	                    raise ScsError("VALIDATION_NOT_AUTHORIZED", "This conversation chose no testing/method-only; test results must remain NOT_RUN.")
   198	                evidence = result.get("evidence", [])
   199	                if result["status"] == "PASS" and not evidence:
   200	                    raise ScsError("EVIDENCE_REQUIRED", "A PASS report needs verifiable evidence; it is not final acceptance.")
   201	                for entry in evidence:
   202	                    if not isinstance(entry, dict) or set(entry) - {"path", "sha256", "required_content"} or not isinstance(entry.get("path"), str):
   203	                        raise ScsError("EVIDENCE_INVALID", "Supply evidence path, sha256 and optional required_content.")
   204	                    check = verify_file(self.store, entry["path"],
   205	                        f"{row['docs_root']}/agent/evidence/{package_id}/R{revision}/{task['id']}", task["kind"], entry.get("required_content"))
   206	                    if check["status"] != "VERIFIED" or entry.get("sha256") != check["sha256"]:
   207	                        raise ScsError("EVIDENCE_INVALID", "Evidence is invalid, insufficient or changed since verification.")
   208	                task.update(status=result["status"], evidence=evidence)
   209	            if target in {"REVIEW_READY", "COMPLETED"} and any(t["status"] in {"FAIL", "BLOCKED"} for t in data["subtasks"]):
   210	                raise ScsError("RESULT_BLOCKED", "Resolve failed/blocked subtasks before reporting review readiness or completion.")
   211	            self._verify_reports(data, row, revision)
   212	            data["updated_at"] = now()
   213	            if closing:
   214	                data["closed_at"] = data["updated_at"]
   215	                data["close_reason"] = close_reason
   216	                data["closed_by_session"] = session_id
   217	            # Every successful mutation consumes one version. Retrying a stale write
   218	            # gives VERSION_CONFLICT rather than silently overwriting another writer.
   219	            con.execute("UPDATE work_packages SET revision=?,version=version+1,state=?,data=? WHERE id=? AND version=?",
   220	                        (revision, target, encode(data), package_id, expected_version))
   221	            self.store.event(con, session_id, None, "work_package_update",
   222	                             "PACKAGE_CLOSED" if closing else "PACKAGE_UPDATED")
   223	            updated = self._get(con, package_id)
   224	            self.store.revision_snapshot(con, updated)
   225	            return self._snapshot(updated)
   226	
   227	    def export(self, session_id: str, package_id: str, expected_version: int) -> dict:
   228	        with self.store.transaction(True) as con:
   229	            row = self._get(con, package_id)
   230	            self._access(con, session_id, row)
   231	            if expected_version != row["version"]:
   232	                raise ScsError("VERSION_CONFLICT", "Refresh before exporting the handoff.")
   233	            self._verify_reports(json.loads(row["data"]), row, row["revision"])
   234	            snapshot = self._snapshot(row)
   235	            # Preferences and identity are deliberately absent: a new chat does intake.
   236	            snapshot.pop("owner_session")
   237	            raw = encode(snapshot)
   238	            digest = hashlib.sha256(raw.encode()).hexdigest()
   239	            hid = "H-" + hashlib.sha256(encode([package_id, digest]).encode()).hexdigest()[:24]
   240	            con.execute("INSERT OR IGNORE INTO handoffs VALUES(?,?,?,?,?)", (hid, package_id, raw, digest, now()))
   241	            return {"status": "EXPORTED", "handoff_id": hid, "sha256": digest, "snapshot": snapshot,
   242	                    "resume": "Use handoff_resume in the new conversation, then independently confirm its intake choices."}
   243	
   244	    def resume(self, session_id: str, handoff_id: str, digest: str) -> dict:
   245	        with self.store.transaction(True) as con:
   246	            self.state._session(con, session_id)
   247	            handoff = con.execute("SELECT * FROM handoffs WHERE id=?", (handoff_id,)).fetchone()
   248	            if not handoff or handoff["digest"] != digest or hashlib.sha256(handoff["snapshot"].encode()).hexdigest() != digest:
   249	                raise ScsError("HANDOFF_INVALID", "Handoff identity or digest does not match this project's audit record.")
   250	            row = self._get(con, handoff["package_id"])
   251	            snapshot = json.loads(handoff["snapshot"])
   252	            if row["version"] != snapshot["version"]:
   253	                raise ScsError("HANDOFF_STALE", "Package changed after export; review and export a fresh handoff.")
   254	            self._verify_reports(json.loads(row["data"]), row, row["revision"])
   255	            con.execute("INSERT OR IGNORE INTO resumes VALUES(?,?)", (handoff_id, session_id))
   256	            self.store.event(con, session_id, None, "handoff_resume", "HANDOFF_RESUMED")
   257	            return {"status": "RESUMED", "package_id": row["id"], "version": row["version"],
   258	                    "session_choices_copied": False, "intake_required": True}
     1	"""Token-fenced advisory leases. No claims about nonparticipating processes."""
     2	
     3	import math
     4	import re
     5	import time
     6	
     7	from .errors import ScsError
     8	from .state import State, identifier
     9	from .storage import Store
    10	
    11	
    12	class Leases:
    13	    def __init__(self, store: Store, clock=time.time):
    14	        self.store = store
    15	        self.state = State(store)
    16	        self.clock = clock
    17	
    18	    def resource(self, resource: str) -> str:
    19	        kind, sep, value = resource.partition(":")
    20	        if not sep or kind not in {"file", "device", "serial", "programmer"}:
    21	            raise ScsError("RESOURCE_INVALID", "Use file:, device:, serial: or programmer: identifiers.")
    22	        if kind == "file":
    23	            return "file:" + self.store.paths.validate(value)
    24	        if not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", value):
    25	            raise ScsError("RESOURCE_INVALID", "Use a simple logical device identifier, not a URL or credential.")
    26	        return resource
    27	
    28	    def acquire(self, session_id: str, resource: str, ttl_seconds: float = 120,
    29	                lease_token: str | None = None) -> dict:
    30	        resource = self.resource(resource)
    31	        if not math.isfinite(ttl_seconds) or not 1 <= ttl_seconds <= 3600:
    32	            raise ScsError("TTL_INVALID", "Lease TTL must be between one second and one hour.")
    33	        stamp = self.clock()
    34	        with self.store.transaction(True) as con:
    35	            self.state._session(con, session_id)
    36	            row = con.execute("SELECT * FROM leases WHERE resource=?", (resource,)).fetchone()
    37	            if row and row["expires"] > stamp:
    38	                if row["owner"] != session_id or row["token"] != lease_token:
    39	                    return {"status": "CONFLICT", "resource": resource, "owner_session": row["owner"], "expires_at": row["expires"], "advisory_only": True}
    40	                token = row["token"]
    41	            else:
    42	                token = identifier("L-")
    43	            con.execute("INSERT INTO leases VALUES(?,?,?,?) ON CONFLICT(resource) DO UPDATE SET owner=excluded.owner,token=excluded.token,expires=excluded.expires",
    44	                        (resource, session_id, token, stamp + ttl_seconds))
    45	            return {"status": "ACQUIRED", "resource": resource, "lease_token": token, "expires_at": stamp + ttl_seconds,
    46	                    "advisory_only": True, "external_processes_excluded": False}
    47	
    48	    def release(self, session_id: str, resource: str, lease_token: str) -> dict:
    49	        resource = self.resource(resource)
    50	        with self.store.transaction(True) as con:
    51	            self.state._session(con, session_id)
    52	            row = con.execute("SELECT * FROM leases WHERE resource=?", (resource,)).fetchone()
    53	            if row is None:
    54	                return {"status": "ALREADY_RELEASED", "resource": resource}
    55	            if row["owner"] != session_id or row["token"] != lease_token:
    56	                raise ScsError("LEASE_OWNER_MISMATCH", "A stale owner/token cannot release this lease.")
    57	            con.execute("DELETE FROM leases WHERE resource=?", (resource,))
    58	            return {"status": "RELEASED", "resource": resource}
     1	"""Conversation identity and explicit, idempotent question state transitions."""
     2	
     3	import hashlib
     4	import json
     5	import re
     6	import uuid
     7	
     8	from .errors import ScsError
     9	from .storage import Store, encode, now
    10	
    11	MODES = ("quick", "standard", "long", "investigate")
    12	VERIFICATION = ("smoke", "targeted", "full", "stability", "none", "method-only")
    13	KINDS = ("mode", "verification", "codex_review")
    14	PENDING = ("REQUESTED", "WAITING_USER", "UNSUPPORTED", "FAILED")
    15	TERMINAL = ("CONFIRMED", "DECLINED", "CANCELLED", "TIMED_OUT")
    16	DESCRIPTIONS = {
    17	    "mode": {
    18	        "quick": "小改动/单文件/直接回答，不建子 Agent",
    19	        "standard": "先确认验证范围，计划后实现与验证",
    20	        "long": "分阶段执行，使用执行子 Agent 与证据",
    21	        "investigate": "只读梳理/评估，不改代码",
    22	    },
    23	    "verification": {
    24	        "smoke": "本轮快速冒烟",
    25	        "targeted": "收尾定向回归",
    26	        "full": "收尾全量回归",
    27	        "stability": "收尾稳定性（长时）",
    28	        "none": "不做测试，结果标 NOT_RUN",
    29	        "method-only": "不执行测试，只记录命令/环境/预期，标 NOT_RUN",
    30	    },
    31	    "codex_review": {
    32	        "no": "收尾不追加 Codex 审查",
    33	        "yes": "收尾用 codex-review 做只读独立审查",
    34	    },
    35	}
    36	OPTIONS = {
    37	    "mode": [{"value": v, "label": label, "desc": DESCRIPTIONS["mode"][v]}
    38	             for v, label in zip(MODES, ("快速处理", "标准执行", "长任务", "只调查"))],
    39	    "verification": [{"value": v, "label": label, "desc": DESCRIPTIONS["verification"][v]}
    40	                     for v, label in zip(VERIFICATION,
    41	        ("本轮冒烟", "收尾定向回归", "收尾全量回归", "收尾稳定性", "不做测试", "不做测试，记录方法"))],
    42	    "codex_review": [{"value": "no", "label": "不使用", "desc": DESCRIPTIONS["codex_review"]["no"]},
    43	                     {"value": "yes", "label": "使用：收尾只读独立审查", "desc": DESCRIPTIONS["codex_review"]["yes"]}],
    44	}
    45	
    46	
    47	def identifier(prefix: str) -> str:
    48	    return prefix + uuid.uuid4().hex
    49	
    50	
    51	def _code(kind: str, value: str) -> str:
    52	    """Accept either the stored code or the display label shown to users."""
    53	    for option in OPTIONS[kind]:
    54	        if value == option["value"] or value == option["label"] or value.startswith(option["value"] + " — "):
    55	            return option["value"]
    56	    return value
    57	
    58	
    59	def check_selection(kind: str, selected: list[str]) -> list[str]:
    60	    selected = [_code(kind, value) for value in selected]
    61	    allowed = {x["value"] for x in OPTIONS[kind]}
    62	    if not selected or len(selected) != len(set(selected)) or any(v not in allowed for v in selected):
    63	        raise ScsError("CHOICE_INVALID", "Choose only listed options, without duplicates.")
    64	    if kind != "verification" and len(selected) != 1:
    65	        raise ScsError("CHOICE_INVALID", "This question requires exactly one option.")
    66	    if kind == "verification" and len(selected) > 1 and set(selected) & {"none", "method-only"}:
    67	        raise ScsError("CHOICE_EXCLUSIVE", "No-testing options are mutually exclusive with all other options.")
    68	    return sorted(selected)
    69	
    70	
    71	class State:
    72	    def __init__(self, store: Store):
    73	        self.store = store
    74	
    75	    def _session(self, con, session_id):
    76	        row = con.execute("SELECT * FROM sessions WHERE id=?", (session_id,)).fetchone()
    77	        if row is None:
    78	            raise ScsError("SESSION_NOT_FOUND", "Open or explicitly recover this conversation first.")
    79	        return row
    80	
    81	    def open(self, project_root: str, client_name: str, conversation_id: str | None = None,
    82	             review_registration: str = "unknown", explicit_skip: bool = False,
    83	             *, resume_session_id: str | None = None) -> dict:
    84	        from pathlib import Path
    85	        if ".." in Path(project_root).parts or Path(project_root).resolve() != self.store.root:
    86	            raise ScsError("PROJECT_MISMATCH", "Session root must match the server's configured project root.")
    87	        if not re.fullmatch(r"[\w .-]{1,64}", client_name) or review_registration not in {"registered", "unregistered", "unknown"}:
    88	            raise ScsError("INPUT_INVALID", "Supply a short client name and known registration state.")
    89	        if conversation_id is not None and (not conversation_id.strip() or len(conversation_id) > 1024):
    90	            raise ScsError("INPUT_INVALID", "Conversation ID must be a nonempty host-provided identifier.")
    91	        if resume_session_id is not None and (conversation_id is not None or explicit_skip):
    92	            raise ScsError("INPUT_INVALID", "Omit conversation_id and explicit_skip when resuming an existing session.")
    93	        temporary = conversation_id is None
    94	        with self.store.transaction(True) as con:
    95	            if resume_session_id is not None:
    96	                row = con.execute(
    97	                    "SELECT id,temporary FROM sessions WHERE id=? AND client=?", (resume_session_id, client_name)
    98	                ).fetchone()
    99	                if row is None:
   100	                    raise ScsError("SESSION_NOT_FOUND", "No matching session for this project and host client.")
   101	                temporary = bool(row["temporary"])
   102	            else:
   103	                identity = hashlib.sha256(
   104	                    encode([str(self.store.root), client_name, conversation_id or uuid.uuid4().hex]).encode()
   105	                ).hexdigest()
   106	                row = con.execute("SELECT id FROM sessions WHERE identity=?", (identity,)).fetchone()
   107	            sid = row["id"] if row else identifier("S-")
   108	            if row is None:
   109	                con.execute("INSERT INTO sessions VALUES(?,?,?,?,?,?,?,?,?)",
   110	                            (sid, identity, client_name, temporary, review_registration,
   111	                             "quick" if explicit_skip else None, None, None, now()))
   112	                self.store.event(con, sid, None, "session_open", "EXPLICIT_SKIP" if explicit_skip else "SESSION_OPENED")
   113	            else:
   114	                if resume_session_id is not None:
   115	                    self.store.event(con, sid, None, "session_open", "SESSION_RESUMED")
   116	                if review_registration != "unknown":
   117	                    # Host attestation may become available after registry loading.
   118	                    updated = con.execute(
   119	                        "UPDATE sessions SET review_registration=? WHERE id=? AND review_registration!=?",
   120	                        (review_registration, sid, review_registration),
   121	                    )
   122	                    if updated.rowcount:
   123	                        self.store.event(con, sid, None, "session_open", "REVIEW_REGISTRATION_UPDATED")
   124	        result = self.get(sid)
   125	        if temporary:
   126	            result["warning"] = "TEMPORARY_SESSION: retain session_id in this chat and pass it as resume_session_id after reconnecting."
   127	        result["destructive_operations_authorized"] = False
   128	        return result
   129	
   130	    def get(self, session_id: str) -> dict:
   131	        with self.store.transaction() as con:
   132	            session = dict(self._session(con, session_id))
   133	            questions = [dict(r) for r in con.execute("SELECT * FROM questions WHERE session_id=? AND current=1 ORDER BY created_at", (session_id,))]
   134	        session.pop("identity")
   135	        session["temporary"] = bool(session["temporary"])
   136	        session["verification"] = json.loads(session["verification"]) if session["verification"] else None
   137	        session["codex_review"] = bool(session["codex_review"]) if session["codex_review"] is not None else None
   138	        for q in questions:
   139	            q["recommendation"] = json.loads(q["recommendation"])
   140	            q["answer"] = json.loads(q["answer"]) if q["answer"] else None
   141	        return {"status": "OK", **session, "questions": questions,
   142	                "unresolved": [q["id"] for q in questions if q["state"] != "CONFIRMED"],
   143	                "question_states": {k: next((q["state"] for q in questions if q["kind"] == k), "NOT_ASKED") for k in KINDS}}
   144	
   145	    def question(self, session_id: str, question_id: str) -> dict:
   146	        with self.store.transaction() as con:
   147	            self._session(con, session_id)
   148	            q = con.execute("SELECT * FROM questions WHERE id=? AND session_id=?", (question_id, session_id)).fetchone()
   149	            if q is None:
   150	                raise ScsError("QUESTION_NOT_FOUND", "Question is not part of this conversation.")
   151	            return dict(q)
   152	
   153	    def request(self, session_id: str, kind: str, recommendation: list[str], channel: str) -> dict:
   154	        if kind not in KINDS or channel not in {"auto", "native", "text"}:
   155	            raise ScsError("INPUT_INVALID", "Unknown question kind or interaction channel.")
   156	        recommendation = check_selection(kind, recommendation)
   157	        with self.store.transaction(True) as con:
   158	            s = self._session(con, session_id)
   159	            q = con.execute("SELECT * FROM questions WHERE session_id=? AND kind=? AND current=1", (session_id, kind)).fetchone()
   160	            if q:
   161	                return {"created": False, **dict(q)}
   162	            # Return the current question so the host can finish it without opening another UI.
   163	            pending = con.execute(
   164	                "SELECT id,kind,state FROM questions WHERE session_id=? AND current=1 AND state != 'CONFIRMED'",
   165	                (session_id,),
   166	            ).fetchone()
   167	            if pending:
   168	                return {"status": "QUESTION_PENDING", "question_id": pending["id"],
   169	                        "kind": pending["kind"], "state": pending["state"],
   170	                        "next": "Use interaction_submit with this question_id after an explicit user reply. "
   171	                                "For an ended question, reopen only on explicit user request."}
   172	            if kind != "mode" and not s["mode"]:
   173	                raise ScsError("QUESTION_ORDER", "Confirm mode first.")
   174	            if kind == "verification" and s["mode"] not in {"standard", "long"}:
   175	                return {"status": "SKIPPED", "reason": "MODE_DOES_NOT_REQUIRE_QUESTION"}
   176	            if kind == "codex_review" and s["mode"] not in {"quick", "standard", "long"}:
   177	                return {"status": "SKIPPED", "reason": "MODE_DOES_NOT_REQUIRE_QUESTION"}
   178	            if kind == "mode" and s["mode"]:
   179	                return {"status": "ALREADY_CONFIRMED", "choice": [s["mode"]]}
   180	            if kind == "codex_review":
   181	                if s["mode"] in {"standard", "long"} and not s["verification"]:
   182	                    raise ScsError("QUESTION_ORDER", "Confirm verification scope first.")
   183	                if s["review_registration"] == "unknown":
   184	                    return {"status": "SKIPPED", "reason": "CODEX_REVIEW_REGISTRATION_UNKNOWN"}
   185	                if s["review_registration"] == "unregistered":
   186	                    return {"status": "SKIPPED", "reason": "CODEX_REVIEW_NOT_REGISTERED"}
   187	                if recommendation != ["no"]:
   188	                    raise ScsError("CHOICE_INVALID", "The review question recommends no additional review.")
   189	            qid = identifier("Q-")
   190	            stamp = now()
   191	            con.execute("INSERT INTO questions VALUES(?,?,?,?,?,?,?,?,?,?)",
   192	                        (qid, session_id, kind, 1, "REQUESTED", channel, encode(recommendation), None, stamp, stamp))
   193	            self.store.event(con, session_id, qid, "interaction_request", "REQUESTED")
   194	            return {"created": True, **dict(con.execute("SELECT * FROM questions WHERE id=?", (qid,)).fetchone())}
   195	
   196	    def claim(self, session_id: str, question_id: str) -> tuple[bool, dict]:
   197	        """Atomically reserve the single UI request across concurrent MCP processes."""
   198	        with self.store.transaction(True) as con:
   199	            q = con.execute("SELECT * FROM questions WHERE id=? AND session_id=?", (question_id, session_id)).fetchone()
   200	            if not q or not q["current"]:
   201	                raise ScsError("LATE_REPLY", "This question was replaced.")
   202	            if q["state"] != "REQUESTED":
   203	                return False, dict(q)
   204	            con.execute("UPDATE questions SET state='WAITING_USER',updated_at=? WHERE id=?", (now(), question_id))
   205	            self.store.event(con, session_id, question_id, "interaction_request", "WAITING_USER")
   206	            return True, dict(con.execute("SELECT * FROM questions WHERE id=?", (question_id,)).fetchone())
   207	
   208	    def mark(self, session_id: str, question_id: str, state: str, error_code: str | None = None) -> dict:
   209	        if state not in {"WAITING_USER", "UNSUPPORTED", "FAILED"}:
   210	            raise ScsError("STATE_INVALID", "Unsupported internal transition.")
   211	        with self.store.transaction(True) as con:
   212	            q = con.execute("SELECT * FROM questions WHERE id=? AND session_id=?", (question_id, session_id)).fetchone()
   213	            if not q or not q["current"]:
   214	                raise ScsError("LATE_REPLY", "Question was replaced; this result cannot affect the current question.")
   215	            if q["state"] in TERMINAL:
   216	                return dict(q)
   217	            con.execute("UPDATE questions SET state=?,updated_at=? WHERE id=?", (state, now(), question_id))
   218	            self.store.event(con, session_id, question_id, "interaction_request", state, error_code,
   219	                             error_code if state in {"UNSUPPORTED", "FAILED"} else None)
   220	        return self.question(session_id, question_id)
   221	
   222	    def submit(self, session_id: str, question_id: str, action: str, choices: list[str] | None = None,
   223	               source: str = "text", observed_timeout: bool = False) -> dict:
   224	        if action not in {"accept", "decline", "cancel", "timeout", "unsupported", "error"} or source not in {"native", "mcp", "text"}:
   225	            raise ScsError("INPUT_INVALID", "Unknown action or reply source.")
   226	        if action == "timeout" and not observed_timeout:
   227	            raise ScsError("TIMEOUT_UNOBSERVED", "An RPC deadline or sleep is not an observed user-interface timeout.")
   228	        if action != "accept" and choices:
   229	            raise ScsError("CHOICE_INVALID", "Only an explicit accepted reply can carry choices.")
   230	        target = {"accept": "CONFIRMED", "decline": "DECLINED", "cancel": "CANCELLED", "timeout": "TIMED_OUT", "unsupported": "UNSUPPORTED", "error": "FAILED"}[action]
   231	        codes = {"accept": "USER_CONFIRMED", "decline": "USER_DECLINED", "cancel": "USER_CANCELLED",
   232	                 "timeout": "HOST_OBSERVED_TIMEOUT", "unsupported": "ELICITATION_UNSUPPORTED", "error": "RPC_ERROR"}
   233	        with self.store.transaction(True) as con:
   234	            self._session(con, session_id)
   235	            q = con.execute("SELECT * FROM questions WHERE id=? AND session_id=?", (question_id, session_id)).fetchone()
   236	            if q is None:
   237	                raise ScsError("QUESTION_NOT_FOUND", "Question is not part of this conversation.")
   238	            if not q["current"]:
   239	                raise ScsError("LATE_REPLY", "A reply for a replaced question is isolated.")
   240	            answer = encode(check_selection(q["kind"], choices or [])) if action == "accept" else None
   241	            if q["state"] in TERMINAL:
   242	                if q["state"] == target and q["answer"] == answer:
   243	                    return {"status": target, "question_id": question_id, "idempotent": True}
   244	                raise ScsError("REPLY_CONFLICT", "This question has already ended. Explicitly reopen to change it.")
   245	            con.execute("UPDATE questions SET state=?,answer=?,updated_at=? WHERE id=?", (target, answer, now(), question_id))
   246	            if action == "accept":
   247	                selected = json.loads(answer)
   248	                column = {"mode": "mode", "verification": "verification", "codex_review": "codex_review"}[q["kind"]]
