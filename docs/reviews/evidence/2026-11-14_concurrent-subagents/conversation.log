   282	            column = {"mode": "mode", "verification": "verification", "codex_review": "codex_review"}[kind]
   283	            con.execute(f"UPDATE sessions SET {column}=NULL WHERE id=?", (session_id,))
   284	            self.store.event(con, session_id, q["id"], "interaction_reopen", "SUPERSEDED")
