   588	    def start_job(self, action, root=None, quiet=False, selection="", payload=None):
   589	        root = root or self.current_root
   590	        if self.busy or not root:
   591	            return
   592	        self.busy = True
   593	        self.action = action
   594	        self.quiet = quiet
   595	        self.output = bytearray()
   596	        self.job_error = ""
   597	        self.projects.setEnabled(False)
   598	        self.status.setText("正在" + {"snapshot": "读取状态", "probe": "执行短期 stdio 自检", "refresh": "刷新视图",
   599	            "scan": "发现项目", "archive": "归档视图", "prepare-obsidian": "准备 Obsidian 文档库",
   600	            "close": "关闭工作包"}[action] + "…") if not quiet else None
   601	        base = Path(__file__).resolve().parents[3]
   602	        default_python = base / ".venv/bin/python"
   603	        server_python = self.settings.get("server_python") or (str(default_python) if default_python.exists() else sys.executable)
   604	        env = QProcessEnvironment.systemEnvironment()
   605	        env.insert("PYTHONPATH", str(Path(__file__).resolve().parents[1]))
   606	        self.job.setProcessEnvironment(env)
   607	        self.job.start(sys.executable, ["-m", "scs_manager.worker", action, "--root", str(root),
   608	            "--python", server_python, "--session", self.sessions.currentData() or "", "--selection", selection])
   609	        if payload is not None:
   610	            self.job.write(json.dumps(payload, ensure_ascii=False).encode())
   611	            self.job.closeWriteChannel()
   612	        self.timeout.start(28000)
   613	
   614	    def read_output(self):
   615	        self.output.extend(bytes(self.job.readAllStandardOutput()))
   616	        if len(self.output) > 2_000_000:
   617	            self.job_error = "响应超过限制"
   618	            self.cancel_job()
   619	
   620	    def drain_error(self):
   621	        self.job.readAllStandardError()  # Drain without persisting arbitrary SDK stderr.
   622	
   623	    @staticmethod
   624	    def kill_owned(job):
   625	        pid=int(job.processId())
   626	        try:
   627	            if pid and os.name=="posix" and os.getpgid(pid)==pid:
   628	                os.killpg(pid,signal.SIGKILL)
   629	            elif job.state()!=QProcess.NotRunning:
   630	                job.kill()
   631	        except ProcessLookupError:
   632	            pass
   633	
   634	    def cancel_job(self):
   635	        self.job_error=self.job_error or "操作超时，已回收本窗口的检查进程；请重新读取状态。"
   636	        self.kill_owned(self.job)
   637	
   638	    def failed_start(self, error):
   639	        if error == QProcess.FailedToStart:
   640	            self.job_error = "无法启动本工具的工作进程"
   641	            self.finished(-1, QProcess.CrashExit)
   642	
   643	    def finished(self, code, _exit_status):
   644	        if not self.busy:
   645	            return
   646	        self.timeout.stop()
   647	        self.read_output()
   648	        self.busy = False
   649	        self.projects.setEnabled(True)
   650	        try:
   651	            if self.job_error:
   652	                raise ValueError(self.job_error)
   653	            reply = json.loads(self.output)
   654	            if not reply.get("ok") or code:
   655	                raise ValueError(reply.get("error", "操作失败"))
   656	            data = reply["data"]
   657	            self.last_error = ""
   658	            if self.action == "prepare-obsidian":
   659	                launch_result=QProcess.startDetached(data["launch_program"],data["launch_arguments"])
   660	                started=launch_result[0] if isinstance(launch_result,tuple) else launch_result
   661	                if not started:
   662	                    raise ValueError("Obsidian 启动失败；请检查安装路径")
   663	                self.record_open()
   664	                self.status.setText("已启动 Obsidian，对应库："+data["vault_root"]+" · 首次配置已自动准备")
   665	                return
   666	            elif self.action == "snapshot":
   667	                self.apply_snapshot(data)
   668	            elif self.action == "scan":
   669	                self.add_paths(data["projects"])
   670	                self.status.setText(f"发现 {len(data['projects'])} 个项目" + ("；已达到扫描上限" if data['truncated'] else ""))
   671	                return
   672	            elif self.action == "probe":
   673	                d = data["diagnostics"]
   674	                self.connection.setText(f"自检成功 · {len(data['tools'])} 个工具 · 服务 {d['server_version']} · {data['checked_at']}\n"
   675	                    "检查实例已结束；宿主连接仍不可观测。")
   676	                self.view_details.setPlainText(json.dumps(data.get("view", {"提示": "选择会话后可检查视图有效性"}), ensure_ascii=False, indent=2))
   677	            else:
   678	                self.view_details.setPlainText(json.dumps(data, ensure_ascii=False, indent=2))
   679	                self.status.setText("操作完成：" + data.get("message", data.get("result", "OK")))
   680	                if not self.closing:
   681	                    QTimer.singleShot(0, lambda: self.start_job("snapshot"))
   682	                return
   683	            if not self.quiet:
   684	                self.status.setText("读取完成" if self.action == "snapshot" else "连接自检完成")
   685	        except Exception as error:
   686	            self.last_error = str(error)
   687	            if self.action == "probe":
   688	                self.connection.setText("最近连接自检失败；宿主连接仍不可观测。")
   689	            self.status.setText("操作未完成：" + str(error))
   690	        finally:
   691	            if self.closing:
   692	                QTimer.singleShot(0, self.close)
   693	
   694	    def apply_snapshot(self, data):
   695	        if data == self.current_snapshot:
   696	            return
   697	        self.current_snapshot = data
   698	        counts = data.get("counts", {})
   699	        v = data["view"]
   700	        closed = sum(1 for package in data["packages"] if package["state"] in CLOSED_STATES)
   701	        self.summary.setText(f"本地数据：{data['database']}　·　会话：{counts.get('sessions', 0)}　·　工作包：{counts.get('work_packages', 0)}（已关闭 {closed}）\n"
   702	                             f"受管视图：{v['state']}　·　{v['count']} 个受管文件")
   703	        selected = self.sessions.currentData()
   704	        self.sessions.clear()
   705	        for s in data["sessions"]:
   706	            if s["mode"] and s["mode"] != "investigate" and (s["mode"] not in {"standard", "long"} or
   707	                s["verification"] and (s["review_registration"] != "registered" or s["codex_review"] is not None)):
   708	                self.sessions.addItem(f"{s['client']} · {s['mode']} · {s['id']}", s["id"])
   709	        index = self.sessions.findData(selected)
   710	        if index >= 0:
   711	            self.sessions.setCurrentIndex(index)
   712	        self.render_packages()
   713	        self.view_info.setText("库目录：" + data['docs_root'] + "\n受管目录：agent/acceptance\n自动刷新：" +
   714	                               ("启用" if v['auto_refresh'] else "未启用") + "　· 最近生成：" + (v.get('refreshed_at') or "—"))
   715	        self.managed_files.clear()
   716	        self.managed_files.addItems(v.get("files", []))
   717	        item=self.projects.currentItem()
   718	        if item and item.data(0,Qt.UserRole+1):
   719	            self.select_package(item.data(0,Qt.UserRole+1))
   720	        self.events.setPlainText("\n".join(f"{e['at']}  {e['tool']}  {e['event']}  {e['error_code'] or ''}" for e in data['events']) or "暂无 MCP 事件。")
   721	
