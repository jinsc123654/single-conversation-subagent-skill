    21	STATE_LABELS = {"PENDING": "待开始", "IN_PROGRESS": "进行中", "REVIEW_READY": "待主对话验收", "BLOCKED": "受阻",
    22	                "COMPLETED": "已完成", "ABANDONED": "已放弃"}
