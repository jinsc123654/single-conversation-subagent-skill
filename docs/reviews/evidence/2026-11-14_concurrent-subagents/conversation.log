   340	def prepare_obsidian(root, selection=None):
   341	    """Use bundled, SDK-free profile helper; no process or global config changes."""
   342	    import shutil
   343	    import sys
   344	    source=Path(__file__).resolve().parents[3] / 'mcp_server/src'
   345	    if source.is_dir() and str(source) not in sys.path:
   346	        sys.path.insert(0,str(source))
   347	    from scs_mcp.paths import Paths
   348	    from scs_mcp.errors import ScsError
   349	    from scs_mcp.vault_profile import prepare_profile, profile_uri
   350	    executable=shutil.which('obsidian')
   351	    if not executable:
   352	        raise ValueError('未找到 Obsidian 程序；请先安装 Obsidian 并加入 PATH')
   353	    target=obsidian_target(root,selection)
   354	    root=canonical(root); vault=inside(root,target['vault_root'])
   355	    if not vault.is_dir():
   356	        raise ValueError('文档库尚不存在；请先生成项目文档或 MCP 视图')
   357	    try:
   358	        profile=prepare_profile(Paths(root),vault.relative_to(root).as_posix())
   359	    except ScsError as error:
   360	        raise ValueError("Obsidian 启动配置无法准备："+str(error)) from None
   361	    note=Path(target['note_path']).relative_to(vault).as_posix() if target.get('note_path') else None
   362	    uri=profile_uri(profile,note)
   363	    program=executable
   364	    arguments=[profile['launch_flag'],uri]
   365	    # Give Obsidian its own user service where available, so restarting the
   366	    # manager cannot terminate an Obsidian process in the manager's cgroup.
   367	    runner=shutil.which('systemd-run')
   368	    if runner and os.environ.get('XDG_RUNTIME_DIR'):
   369	        import subprocess
   370	        try:
   371	            status=subprocess.run(['systemctl','--user','is-system-running'],capture_output=True,text=True,timeout=2)
   372	            if status.stdout.strip() in {'running','degraded'}:
   373	                program=runner
   374	                arguments=['--user','--collect','--quiet','--description=Obsidian project',executable,*arguments]
   375	        except (OSError,subprocess.TimeoutExpired):
   376	            pass
   377	    return {**profile,'executable':executable,'uri':uri,'vault_root':str(vault),
   378	            'launch_program':program,'launch_arguments':arguments}
